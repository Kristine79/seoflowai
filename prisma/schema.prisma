generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DirectoryCategory {
  BUSINESS_DIRECTORY
  AGENCY_DIRECTORY
  REVIEW_PLATFORM
  PORTFOLIO_PLATFORM
  SOCIAL_PROFILE
  CONTENT_PLATFORM
  GOVERNMENT_RESOURCE
  PARTNER_DIRECTORY
  CITATION_AGGREGATOR
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum AutomationLevel {
  EASY
  MEDIUM
  HARD
  MANUAL
}

enum TaskStatus {
  PENDING
  AI_PREPARED
  READY
  IN_PROGRESS
  WAITING_VERIFICATION
  VERIFICATION_REQUIRED
  COMPLETED
  REJECTED
  PAYMENT_REQUIRED
}

enum AiSearchPromptCategory {
  BRAND
  PRODUCT
  CATEGORY
  BUYER_INTENT
  USE_CASE
  COMPARISON
  ALTERNATIVES
  PROBLEM_SOLUTION
  EXPERT_TECHNICAL
  COMPETITOR
}

enum AiSearchAuditStatus {
  DRAFT
  READY
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

model Company {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  legalName   String?
  website     String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  founded     String?
  category    String?
  serviceArea String?
  services    String?
  keywords    String?
  descriptionShort  String?
  descriptionMedium String?
  descriptionLong   String?
  logo        String?

  directories   Directory[]
  campaigns     Campaign[]
  aiSearchAudits AiSearchAudit[]
}

model Campaign {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  description String?
  status      String   @default("ACTIVE")

  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])

  directories Directory[]
}

model Directory {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  platform    String
  url         String?
  priority    Priority @default(MEDIUM)
  category    String?
  notes       String?
  status      TaskStatus @default(PENDING)
  liveUrl     String?
  startedAt   DateTime?
  completedAt DateTime?
  checklistProgress String?
  automationMode    String  @default("MANUAL")

  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])

  seoAudit        SeoAudit?
  submission      Submission?
  generatedContent GeneratedContent?
  submissionTemplate SubmissionTemplate?
  automationJobs  AutomationJob[]
}

model SeoAudit {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  platformType    DirectoryCategory?
  seoScore        Int?
  priority        Priority?
  automationLevel AutomationLevel?
  automationReason String?
  valueReason     String?
  requiredAssets  String?
  duplicateWarning String?
  recommendation String?
  estimatedTime   Int?
  seoScoreBreakdown String?
  quickWin        String?

  directoryId   String   @unique
  directory     Directory @relation(fields: [directoryId], references: [id])
}

model Submission {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  login       String?
  password    String?
  listingUrl  String?
  notes       String?
  completedAt DateTime?
  verificationStatus String @default("PENDING")

  directoryId   String   @unique
  directory     Directory @relation(fields: [directoryId], references: [id])
}

model GeneratedContent {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shortDescription  String?
  mediumDescription String?
  longDescription   String?
  serviceDescription String?
  serviceList       String?
  socialBio         String?
  keywords          String?
  primaryKeywords   String?
  secondaryKeywords String?
  suggestedCategories String?

  directoryId   String   @unique
  directory     Directory @relation(fields: [directoryId], references: [id])
}

model SubmissionTemplate {
  id            String   @id @default(cuid())
  fieldMapping  Json
  formStructure Json
  submitSelector String?
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  directoryId   String   @unique
  directory     Directory @relation(fields: [directoryId], references: [id])
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  NEEDS_MANUAL
}

enum AutomationMode {
  PREVIEW
  SUBMIT
}

model AutomationJob {
  id          String         @id @default(cuid())
  status      JobStatus      @default(PENDING)
  mode        AutomationMode @default(PREVIEW)
  startedAt   DateTime?
  finishedAt  DateTime?
  screenshot  String?
  error       String?
  logs        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  directoryId   String
  directory     Directory @relation(fields: [directoryId], references: [id])

  @@index([directoryId])
}

model AiSearchAudit {
  id             String             @id @default(cuid())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  name           String
  status         AiSearchAuditStatus @default(DRAFT)
  brand          String
  website        String?
  description    String?
  categoryPhrase String?
  products       String?
  market         String?
  targetAudience String?
  useCases       String?
  problems       String?
  competitors    String?
  promptLanguage String            @default("en")
  executedAt     DateTime?
  completedAt    DateTime?
  promptCount    Int                @default(0)
  promptSetVersion Int              @default(1)
  promptSetHash  String?
  report         String?
  reportGeneratedAt DateTime?

  sourceCompanyId String?
  sourceCompany   Company? @relation(fields: [sourceCompanyId], references: [id])

  prompts   AiSearchPrompt[]
  responses AiSearchResponse[]
  runs      AiSearchRun[]
  gaps      AiSearchGap[]
  actions   AiSearchAction[]
  issues    AiSearchIssue[]

  @@index([sourceCompanyId])
}

model AiSearchRun {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  runNumber   Int      @default(1)
  mode        String   @default("chat")
  status      String   @default("RUNNING")
  startedAt   DateTime?
  completedAt DateTime?
  promptSetVersion Int  @default(1)
  promptSetHash String?
  providers   Json?
  error       String?

  auditId   String
  audit     AiSearchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  responses AiSearchResponse[]

  @@index([auditId])
}

model AiSearchPrompt {
  id          String                @id @default(cuid())
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  auditId     String
  audit       AiSearchAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category    AiSearchPromptCategory
  templateKey String?
  text        String
  enabled     Boolean               @default(true)
  custom      Boolean               @default(false)
  position    Int                   @default(0)

  responses AiSearchResponse[]

  @@index([auditId])
}

model AiSearchResponse {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  auditId     String
  audit       AiSearchAudit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  runId       String?
  run         AiSearchRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  promptId    String
  prompt      AiSearchPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING")
  error       String?
  provider    String?
  model       String?
  promptText  String?
  rawResponse String?
  analysis    Json?
  positioning Json?
  citations   Json?
  usage       Json?
  latencyMs   Int?
  webSearchUsed Boolean @default(false)
  startedAt   DateTime?
  completedAt DateTime?

  @@index([auditId])
  @@index([runId])
  @@index([promptId])
}

model AiSearchIssue {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  auditId     String
  audit       AiSearchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  promptId    String?
  responseId  String?
  claim       String
  status      String   @default("PENDING_REVIEW")
  note        String?
  reviewedAt  DateTime?

  @@index([auditId])
}

model AiSearchGap {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  auditId     String
  audit       AiSearchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  type        String
  severity    String   @default("MEDIUM")
  title       String
  description String?
  hypothesis  String?
  evidence    Json?
  status      String   @default("OPEN")

  actions AiSearchAction[]

  @@index([auditId])
}

model AiSearchAction {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  auditId          String
  audit            AiSearchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  gapId            String?
  gap              AiSearchGap? @relation(fields: [gapId], references: [id], onDelete: SetNull)
  priority         String   @default("MEDIUM")
  problem          String
  evidence         Json?
  recommendation   String
  target           String?
  expectedPurpose  String?
  whyThisAction    String?
  verificationMethod String?
  status           String   @default("SUGGESTED")
  note             String?
  implementedDate  DateTime?
  affectedUrl      String?

  @@index([auditId])
}
